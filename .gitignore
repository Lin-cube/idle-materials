# ============================================================
# 校园闲置物资管理平台 · Git 忽略规则
# 作用: 防止把依赖包/编译产物/含密码的配置文件传到 GitHub
# ============================================================

# ---------- 前端 ----------
# npm 依赖(11814个文件, 132MB, 别人 npm install 就能装回来)
frontend/node_modules/
frontend/dist/

# ---------- 后端 ----------
# Maven 编译产物
backend/target/
backend/*.iml

# ---------- 敏感配置 ----------
# 含 MySQL 密码的配置文件, 不上传! 请复制 application.yml.example 改名使用
backend/src/main/resources/application.yml

# ---------- 运行时产物 ----------
# 上传的物资图片(每次运行可能不同, 按需决定是否提交种子图片)
# backend/uploads/
# 日志
*.log
logs/

# ---------- 系统与编辑器 ----------
.DS_Store
.idea/
.vscode/
*.swp
